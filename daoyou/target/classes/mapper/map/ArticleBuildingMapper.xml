<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.daoyou.map.mapper.ArticleBuildingMapper">
 <select id="countByBuildingId" resultType="int">
 SELECT COUNT(1) FROM articles WHERE building_id = #{buildingId} AND is_deleted =0
 </select>
</mapper>
